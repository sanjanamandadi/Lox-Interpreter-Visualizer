# Copy to .env and edit if the Java trace backend isn't on the default port.
# Only variables prefixed VITE_ are exposed to the browser; Vite inlines them at
# build time, so changing this needs a dev-server restart or a fresh build.
#
# Default when unset: http://localhost:8080/api/trace
VITE_API_URL=http://localhost:8080/api/trace
